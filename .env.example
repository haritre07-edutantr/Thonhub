# Local development; on Vercel use your production Turso URL instead.
TURSO_DATABASE_URL=file:./.local/thonhub.db
TURSO_AUTH_TOKEN=

# Confirm this email using a sign-in link to access the admin workspace.
ADMIN_EMAIL=

# Resend sender domain is already verified in your account.
EMAIL_FROM="Thon Hub <events@thonhub.com>"
RESEND_API_KEY=

# Connect a PRIVATE Vercel Blob store for 10 MB image/PDF uploads.
BLOB_READ_WRITE_TOKEN=

# Local development. On Vercel set your HTTPS site address or omit APP_URL.
APP_URL=http://localhost:3000
